{
  "version": "1.0",
  "executor": "hatchet",
  "settings": {
    "timeout": "2m",
    "retryPolicy": {
      "maxAttempts": 3,
      "backoffCoefficient": 2,
      "initialInterval": "1s",
      "maxInterval": "30s"
    }
  },
  "edges": [],
  "steps": [
    {
      "id": "trigger",
      "type": "trigger",
      "name": "Email Requested",
      "position": { "x": 0, "y": 0 },
      "trigger": {
        "type": "event",
        "config": {
          "pattern": "gatekeeper.email.*",
          "source": "omni.gatekeeper"
        }
      },
      "next": "render"
    },
    {
      "id": "render",
      "type": "action",
      "name": "Render Email Template",
      "position": { "x": 0, "y": 100 },
      "action": {
        "pluginId": "builtin:emailRender",
        "operation": "render",
        "inputs": {
          "templateId": "{{trigger.data.templateId}}",
          "templateData": "{{trigger.data.templateData}}"
        }
      },
      "next": "send"
    },
    {
      "id": "send",
      "type": "email",
      "name": "Send Email",
      "position": { "x": 0, "y": 200 },
      "email": {
        "to": "{{trigger.data.to}}",
        "from": "noreply@send.omni.dev",
        "subject": "{{steps['render'].output.subject}}",
        "body": "{{steps['render'].output.html}}",
        "contentType": "html"
      },
      "next": "end"
    },
    {
      "id": "end",
      "type": "stop",
      "name": "Workflow Complete",
      "position": { "x": 0, "y": 300 },
      "stop": {
        "status": "success",
        "reason": "Email sent successfully"
      }
    }
  ]
}
