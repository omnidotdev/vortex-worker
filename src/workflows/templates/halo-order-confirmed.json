{
  "version": "1.0",
  "executor": "hatchet",
  "settings": {
    "timeout": "2m",
    "retryPolicy": {
      "maxAttempts": 3,
      "backoffCoefficient": 2,
      "initialInterval": "1s",
      "maxInterval": "30s"
    }
  },
  "edges": [],
  "steps": [
    {
      "id": "trigger",
      "type": "trigger",
      "name": "Order Confirmed",
      "position": { "x": 0, "y": 0 },
      "trigger": {
        "type": "event",
        "config": {
          "pattern": "halo.order.confirmed",
          "source": "omni.halo"
        }
      },
      "next": "build-emails"
    },
    {
      "id": "build-emails",
      "type": "code",
      "name": "Build Order Emails",
      "position": { "x": 0, "y": 100 },
      "code": {
        "sandbox": "worker",
        "source": "const d = trigger.data; const fmt = (c) => new Intl.NumberFormat('en-US', { style: 'currency', currency: d.currency || 'USD' }).format((c || 0) / 100); const rows = (d.lines || []).map((l) => `<tr><td style='padding:6px 0'>${l.title}${l.variantTitle ? ' - ' + l.variantTitle : ''} &times; ${l.quantity}</td><td style='padding:6px 0;text-align:right'>${fmt(l.total)}</td></tr>`).join(''); const totals = [['Subtotal', d.subtotal], d.discountTotal ? ['Discount', -d.discountTotal] : null, d.shippingTotal ? ['Shipping', d.shippingTotal] : null, d.taxTotal ? ['Tax', d.taxTotal] : null].filter(Boolean).map((t) => `<tr><td style='padding:2px 0;color:#555'>${t[0]}</td><td style='padding:2px 0;text-align:right;color:#555'>${fmt(t[1])}</td></tr>`).join(''); const summary = `<table style='width:100%;border-collapse:collapse;font-family:sans-serif;font-size:14px'>${rows}<tr><td colspan='2' style='border-top:1px solid #eee;padding-top:8px'></td></tr>${totals}<tr><td style='padding-top:6px;font-weight:700'>Total</td><td style='padding-top:6px;text-align:right;font-weight:700'>${fmt(d.total)}</td></tr></table>`; const buyerHtml = `<div style='max-width:560px;margin:0 auto;font-family:sans-serif;color:#111'><h2>Thank you for your order</h2><p>${d.storeName} received your order <strong>${d.orderNumber}</strong>. Here is your receipt.</p>${summary}<p style='color:#888;font-size:12px;margin-top:24px'>Questions? Just reply to this email.</p></div>`; const sellerHtml = `<div style='max-width:560px;margin:0 auto;font-family:sans-serif;color:#111'><h2>New order ${d.orderNumber}</h2><p>${d.storeName} received a new order from ${d.buyerEmail}.</p>${summary}</div>`; return { buyerEmail: d.buyerEmail || '', buyerSubject: `Your ${d.storeName} order ${d.orderNumber}`, buyerHtml, sellerEmail: d.sellerEmail || '', sellerSubject: `New order ${d.orderNumber} - ${d.storeName}`, sellerHtml, hasSeller: !!d.sellerEmail };"
      },
      "next": "send-buyer"
    },
    {
      "id": "send-buyer",
      "type": "email",
      "name": "Email Buyer",
      "position": { "x": 0, "y": 200 },
      "email": {
        "to": "{{steps['build-emails'].output.buyerEmail}}",
        "subject": "{{steps['build-emails'].output.buyerSubject}}",
        "body": "{{steps['build-emails'].output.buyerHtml}}",
        "contentType": "html"
      },
      "next": "check-seller"
    },
    {
      "id": "check-seller",
      "type": "condition",
      "name": "Has Seller?",
      "position": { "x": 0, "y": 300 },
      "condition": {
        "expression": "{{ steps['build-emails'].output.hasSeller === true }}",
        "trueBranch": "send-seller",
        "falseBranch": "end"
      }
    },
    {
      "id": "send-seller",
      "type": "email",
      "name": "Email Seller",
      "position": { "x": 0, "y": 400 },
      "email": {
        "to": "{{steps['build-emails'].output.sellerEmail}}",
        "subject": "{{steps['build-emails'].output.sellerSubject}}",
        "body": "{{steps['build-emails'].output.sellerHtml}}",
        "contentType": "html"
      },
      "next": "end"
    },
    {
      "id": "end",
      "type": "stop",
      "name": "Workflow Complete",
      "position": { "x": 0, "y": 500 },
      "stop": {
        "status": "success",
        "reason": "Halo order emails processed"
      }
    }
  ]
}
